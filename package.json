  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "ajv-cli": "^5.0.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "parcel": "^2.16.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
