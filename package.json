{
  "name": "cse5911-capstone-project",
  "version": "1.0.0",
  "type": "module",
  "description": "Web-based freezer navigation and training simulator for research laboratory staff and student workers.",
  "scripts": {
    "start": "parcel index.html --dist-dir .parcel-dev --public-url /",
    "test": "vitest",
    "build": "parcel build index.html --public-url /CSE5911-Freezer-Simulator/",
    "gen:types": "json2ts -i src/models/freezer-layout.schema.json -o src/models/generated/freezerLayout.types.ts --ignoreMinAndMaxItems"
  },
